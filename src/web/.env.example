# Local Supabase (`npm run db:start`). These are the CLI's standard local-only
# values, not secrets; `npx supabase status` prints them. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The miner service (src/miner), used server-side for XES upload. Leave unset and
# XES upload says the service isn't available; CSV and Excel still work.
# Run it locally: cd src/miner && SUPABASE_URL=http://127.0.0.1:54321 uv run uvicorn --factory throughline_miner.main:create_app --port 8000
MINER_URL=http://127.0.0.1:8000
