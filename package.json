{
  "name": "throughline",
  "version": "0.1.0",
  "private": true,
  "description": "Process discovery for operations teams: upload an event log, see how work really flows, and what the bottlenecks cost.",
  "license": "MIT",
  "author": "Sage Edwards",
  "type": "module",
  "workspaces": [
    "src/engine",
    "src/datagen",
    "src/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "datagen": "npm run generate -w @throughline/datagen",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "dev": "npm run dev -w @throughline/web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
